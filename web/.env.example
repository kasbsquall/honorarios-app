# Public domain used by the payment links the panel generates. A client abroad receives
# the link, so it cannot point to the machine where it was generated.
# Without this variable the app uses the browser's origin.
VITE_PUBLIC_BASE=https://your-deployment.example

# The two below are the test signer for `?dev=client` and `?dev=freelancer`.
# They only exist with `npm run dev`: Vite leaves them out of the production build.
# They go in .env.development.local (outside the repo), never here with their real value.

# Testnet secret key of the account that pays in the e2e/ scripts.
VITE_DEV_CLIENT_SECRET=S...

# Testnet secret key of the account that gets paid in the e2e/ scripts.
VITE_DEV_FREELANCER_SECRET=S...
